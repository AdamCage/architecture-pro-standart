@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_WITH_LEGEND()

Person_Ext(customer, "Клиент")
Person(cc_agent, "Агент КЦ", "Консультирует по ставкам")
Person_Ext(pcc_agent, "Агент партнёрского КЦ")

System_Ext(pcc, "Система партнёрского КЦ", "Внешняя, получает файлы со ставками")

System_Boundary(bank, "Банк «Стандарт»") {
  System(rate, "Rate Service + Admin UI", "Java/.NET + PostgreSQL", "Единый источник ставок, аудит")
  System(cc, "CRM КЦ", "React + Spring Boot", "Рабочее место операторов")
  System(rproxy, "Rates Proxy (КЦ)", "Java/.NET", "Кэш/адаптер ставок для CRM КЦ")
  System(exporter, "Rates Exporter", "Batch/Worker", "Генерация и доставка файлов ставок")
  System(dmz, "File Gateway (DMZ)", "SFTP/FTPS/Email", "Внешняя передача")
  System(bus, "Kafka", "Event bus", "rate.updated")
  System(obs, "Observability", "Prometheus/Grafana/OTel", "Метрики/логи/трейсы")
}

Rel(cc_agent, cc, "Работа в CRM КЦ")
Rel(cc, rproxy, "Запрос актуальных ставок", "REST/cache")
Rel(rproxy, rate, "GET /rates (read-only)", "TLS")
Rel(rate, bus, "Публикует rate.updated")

Rel(exporter, bus, "Подписка rate.updated")
Rel(exporter, rate, "Чтение ставок для файла")
Rel(exporter, dmz, "Передача файла + подпись/шифрование")
Rel(dmz, pcc, "Доставка файла (односторонне)")

Rel(pcc_agent, pcc, "Просмотр ставок")
Rel(obs, (rate, rproxy, exporter, dmz), "Сбор метрик/логов")

@enduml
